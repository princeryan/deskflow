// Allow a local, active desktop session to start/stop/restart the Deskflow
// login-screen client service without a password prompt, so the Deskflow GUI
// can act as a front-end for deskflow-uinput.service.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "deskflow-uinput.service" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
